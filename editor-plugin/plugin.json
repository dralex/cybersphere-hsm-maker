{
  "api": 1,
  "id": "hsm-maker",
  "name": "HSM Maker",
  "version": "0.1.0",
  "description": "Draws a new diagram from a description or a picture, or changes the open one, with a language model; the description, the picture and the diagram are sent to the model server",
  "icon": "icons/draw.svg",
  "interpreter": "python3",
  "env": {
    "PYTHONUTF8": "1"
  },
  "parameters": [
    {
      "id": "prompt",
      "type": "text",
      "label": "Description",
      "scope": "run",
      "required": false,
      "language": "markdown",
      "description": "The system the diagram is about, in any language; with a picture, a comment to it"
    },
    {
      "id": "change",
      "type": "text",
      "label": "What to change",
      "scope": "run",
      "required": false,
      "language": "markdown",
      "description": "The change of the open diagram"
    },
    {
      "id": "picture",
      "type": "file",
      "label": "Picture",
      "scope": "run",
      "filter": "Pictures (*.png *.jpg *.jpeg *.gif *.webp)",
      "description": "Optional: a picture of the system or of the change (PNG, JPEG, GIF, WebP); the text is then its comment"
    },
    {
      "id": "layout",
      "type": "enum",
      "label": "Layout",
      "scope": "run",
      "choices": [
        "update",
        "full"
      ],
      "default": "update",
      "description": "update keeps the drawing and places the new elements; full lays the diagram out anew"
    },
    {
      "id": "model",
      "type": "string",
      "label": "Model",
      "scope": "persistent",
      "required": true,
      "default": "deepseek-flash"
    },
    {
      "id": "url",
      "type": "string",
      "label": "Server",
      "scope": "persistent",
      "required": true,
      "default": "https://api.deepseek.com/v1"
    },
    {
      "id": "protocol",
      "type": "enum",
      "label": "Protocol",
      "scope": "persistent",
      "choices": [
        "chat-completions",
        "messages"
      ],
      "default": "chat-completions"
    },
    {
      "id": "key",
      "type": "secret",
      "label": "API key",
      "scope": "persistent",
      "default": "env:DEEPSEEK_API_KEY",
      "export": "HSM_MAKER_API_KEY",
      "description": "env:NAME or file:PATH; empty for a local server"
    },
    {
      "id": "language",
      "type": "enum",
      "label": "Language",
      "scope": "persistent",
      "choices": [
        "auto",
        "en",
        "ru"
      ],
      "default": "auto",
      "description": "The language of the instructions; auto follows the description, else the editor"
    },
    {
      "id": "code_language",
      "type": "enum",
      "label": "Code language",
      "scope": "persistent",
      "choices": [
        "auto",
        "C",
        "C++",
        "C#",
        "Java",
        "JavaScript",
        "Python"
      ],
      "default": "auto",
      "description": "The programming language of the actions; auto: the model declares it, a changed diagram keeps its own"
    },
    {
      "id": "rounds",
      "type": "int",
      "label": "Rounds",
      "scope": "persistent",
      "default": 3,
      "min": 1,
      "max": 10,
      "description": "How many times the model may correct its answer"
    },
    {
      "id": "verbose",
      "type": "bool",
      "label": "Show the dialog",
      "scope": "persistent",
      "default": false,
      "description": "Show every message to the model and every answer in the output tab; the progress and the hints are shown anyway"
    }
  ],
  "actions": [
    {
      "id": "draw",
      "label": "Draw a new diagram...",
      "result": "new-document",
      "toolbar": true,
      "icon": "icons/draw.svg",
      "timeout": 600,
      "load": {
        "strict": true
      },
      "parameters": [
        "prompt",
        "picture",
        "model",
        "url",
        "protocol",
        "key",
        "language",
        "code_language",
        "rounds",
        "verbose"
      ],
      "description": "A new diagram from a description or a picture",
      "argv": [
        "-m",
        "hsm_maker",
        "-f",
        "${param-file:prompt}",
        {
          "if": "picture",
          "argv": [
            "--picture",
            "${param:picture}"
          ]
        },
        "-o",
        "${output}",
        "--diagnostics",
        "${diagnostics}",
        "--model",
        "${param:model}",
        "--url",
        "${param:url}",
        "--protocol",
        "${param:protocol}",
        "--language",
        "${param:language}",
        "--code-language",
        "${param:code_language}",
        "--rounds",
        "${param:rounds}",
        {
          "if": "verbose",
          "argv": [
            "-v"
          ]
        }
      ]
    },
    {
      "id": "change",
      "label": "Change the diagram...",
      "result": "replace",
      "toolbar": true,
      "icon": "icons/change.svg",
      "timeout": 600,
      "load": {
        "strict": true
      },
      "parameters": [
        "change",
        "picture",
        "layout",
        "model",
        "url",
        "protocol",
        "key",
        "language",
        "code_language",
        "rounds",
        "verbose"
      ],
      "description": "The open diagram changed by a description or a picture of the change",
      "argv": [
        "-m",
        "hsm_maker",
        "--update",
        "${input}",
        "-f",
        "${param-file:change}",
        {
          "if": "picture",
          "argv": [
            "--picture",
            "${param:picture}"
          ]
        },
        "--geometry",
        "${param:layout}",
        "-o",
        "${output}",
        "--diagnostics",
        "${diagnostics}",
        "--model",
        "${param:model}",
        "--url",
        "${param:url}",
        "--protocol",
        "${param:protocol}",
        "--language",
        "${param:language}",
        "--code-language",
        "${param:code_language}",
        "--rounds",
        "${param:rounds}",
        {
          "if": "verbose",
          "argv": [
            "-v"
          ]
        }
      ]
    },
    {
      "id": "notation",
      "label": "Show the notation",
      "result": "log",
      "parameters": [],
      "icon": "icons/check.svg",
      "description": "The open diagram in the notation the model reads",
      "argv": [
        "-m",
        "hsm_maker",
        "--render",
        "${input}"
      ]
    }
  ]
}
